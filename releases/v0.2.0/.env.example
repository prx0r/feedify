# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8787

# Core API
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_FILE=./data/feedify.json
FEEDIFY_RUN_INTERVAL_MS=900000

# Optional AI provider (OpenAI-compatible /chat/completions API)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# X ingestion via GetXAPI
GETX_API_KEY=
GETX_BASE_URL=https://api.getxapi.com

# GitHub discovery. Optional for public search, recommended for rate limits.
GITHUB_TOKEN=
GITHUB_BASE_URL=https://api.github.com

# Official X publishing/reposting
X_USER_ACCESS_TOKEN=
X_USER_ID=
X_API_BASE_URL=https://api.x.com/2

# x402 gateway (run separately: npm run dev:x402)
FEEDIFY_API_URL=http://localhost:8787
X402_PUBLIC_BASE_URL=http://localhost:8790
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAY_TO=
X402_NETWORK=eip155:8453

# MCP gateway (run separately: npm run dev:mcp)
MCP_PUBLIC_BASE_URL=http://localhost:8791

# Optional webhook HMAC secret. Outputs can refer to another env var using config.secretEnv.
FEEDIFY_WEBHOOK_SECRET=
