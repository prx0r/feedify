# Core
FEEDIFY_DATABASE_URL=sqlite:///./feedify.db
FEEDIFY_PUBLIC_BASE_URL=http://localhost:8000
FEEDIFY_INGEST_LIMIT=25

# Optional AI enrichment (OpenAI-compatible: OpenRouter, DeepSeek, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Signal sources
TRUSTMRR_API_KEY=
STORELEADS_API_KEY=
APPFIGURES_USERNAME=
APPFIGURES_PASSWORD=
APPFIGURES_CLIENT_KEY=
APPFIGURES_PRODUCT_IDS=
GITHUB_TOKEN=
APIFY_TOKEN=

# X/Twitter intelligence via GetXAPI (main Feedify engine)
# Get keys at https://getxapi.com — reads ~$0.001/call, balance check free
GETXAPI_KEY=
GETXAPI_BACKUP_KEY=
GETXAPI_WATCHLIST_PATH=config/quantum_watchlist.json
GETXAPI_PER_HANDLE_COUNT=3
GETXAPI_MAX_HANDLES=8

# Generic remote MCP sources (JSON array). Example Store Leads + Apify:
# MCP_SOURCES_JSON=[{"name":"storeleads","url":"https://storeleads.app/mcp","bearer_env":"STORELEADS_API_KEY"},{"name":"apify","url":"https://mcp.apify.com"}]
MCP_SOURCES_JSON=[]

# Optional x402 output gating (kept off by default)
X402_ENABLED=false
X402_PAY_TO=
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD=0.01
