      "quoted_tweet": {
        "id": "2093425601554391330",
        "text": "Kimi K3 full fine-tuning is live on AC2. Our memory optimizations reduced GPUs required per training replica by ~40%.\n\nAt nearly 3T parameters, Kimi forced us to rethink how we manage memory, communication, rollouts, and checkpoints. The result is a much more efficient path to https://t.co/FLc7FVxJyQ",
        "user": {
          "name": "Applied Compute",
          "screen_name": "appliedcompute"
        }
      },
      "retweeted_tweet": null
    },
    {
      "type": "tweet",
      "id": "2093430306804044033",
      "url": "https://x.com/agarwl_/status/2093430306804044033",
      "twitterUrl": "https://twitter.com/agarwl_/status/2093430306804044033",
      "text": "One-line change to make multi-teacher OPD much better: \n\nMOPD: take a base model, do RL on N separate tasks to get N experts, distill the experts to a single model\n\nMOPD+: Distill the delta between RL'ed expert and base for each of the N experts.",
      "source": "Twitter for Android",
      "retweetCount": 25,
      "replyCount": 6,
      "likeCount": 285,
      "quoteCount": 2,
      "viewCount": 28199,
      "createdAt": "Fri Aug 28 20:07:33 +0000 2026",
